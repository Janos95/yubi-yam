<mujoco model="yubi_4310">
  <!-- Generated by yubi-yam/sim/build_model.py. YUBI gripper (Toyota/AIRoA, CERN-OHL-W-2.0)
       re-motored with a DM4310 for the I2RT YAM. Units: metres, radians. -->
  <compiler angle="radian" meshdir="assets"/>

  <asset>
    <mesh name="yubi_base" file="base.stl"/>
    <mesh name="yubi_finger_r" file="finger_r.stl"/>
    <mesh name="yubi_finger_l" file="finger_l.stl"/>
    <mesh name="yubi_pad_r" file="pad_r.stl"/>
    <mesh name="yubi_pad_l" file="pad_l.stl"/>
  </asset>

  <worldbody>
    <body name="gripper" pos="0 0 0" quat="0 0.70711 0.70711 0">
      <inertial pos="-0.00419951 0.011121 -0.036657" mass="0.4430" diaginertia="0.000302742 0.000546557 0.000588837"/>
      <geom type="mesh" mesh="yubi_base" rgba="0.23 0.25 0.27 1" contype="0" conaffinity="0"/>
      <site name="tcp_site" pos="0 0 0" quat="0 1 0 0" size="0.005" rgba="1 0 0 1"/>
      <!-- grasp_site: between the pads, 8 mm up from their tips; fixed for all openings
           to within a few mm (the fingers pivot, so the pinch point moves slightly). -->
      <site name="grasp_site" pos="0 0.00153274 -0.143139" quat="0 1 0 0" size="0.005" rgba="0 1 0 1"/>
      <body name="finger_r" pos="-0.015 0.0065 -0.045996">
        <inertial pos="-0.00480548 -0.00338497 -0.0322808" mass="0.0982" diaginertia="1.84974e-05 8.1095e-05 8.4435e-05"/>
        <joint name="joint7" type="hinge" axis="0 1 0" range="-0.09599 0.62832" damping="0.02"/>
        <geom type="mesh" mesh="yubi_finger_r" pos="0.015 -0.0065 0.045996" rgba="0.78 0.20 0.17 1" contype="0" conaffinity="0"/>
        <geom name="pad_r" type="mesh" mesh="yubi_pad_r" pos="0.015 -0.0065 0.045996" rgba="0.08 0.08 0.08 1" friction="1.2 0.02 0.002"/>
      </body>
      <body name="finger_l" pos="0.015 0.0065 -0.045996">
        <inertial pos="0.00539916 -0.00732917 -0.0364631" mass="0.0935" diaginertia="1.34354e-05 7.46666e-05 7.92179e-05"/>
        <joint name="joint8" type="hinge" axis="0 1 0" range="-0.62832 0.09599" damping="0.02"/>
        <geom type="mesh" mesh="yubi_finger_l" pos="-0.015 -0.0065 0.045996" rgba="0.78 0.20 0.17 1" contype="0" conaffinity="0"/>
        <geom name="pad_l" type="mesh" mesh="yubi_pad_l" pos="-0.015 -0.0065 0.045996" rgba="0.08 0.08 0.08 1" friction="1.2 0.02 0.002"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- 1:1 spur gears: the left finger turns opposite to the right one -->
    <joint joint1="joint8" joint2="joint7" polycoef="0 -1 0 0 0"/>
  </equality>

  <contact>
    <exclude body1="gripper" body2="finger_r"/>
    <exclude body1="gripper" body2="finger_l"/>
    <exclude body1="finger_r" body2="finger_l"/>
  </contact>
</mujoco>
